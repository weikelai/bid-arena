# Development only. Run: node scripts/setup-env.mjs
APP_ENV=development
SEED_DEMO=true
DB_NAME=bid_arena
DB_USER=bid_arena
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
BACKEND_PORT=8080
FRONTEND_PORT=5173
# Used when running the backend on the host, not inside Compose.
DB_URL=jdbc:mysql://127.0.0.1:3307/bid_arena?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&useSSL=false
